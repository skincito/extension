{
  "manifest_version": 3,
  "name": "Skincito Trade Assistant",
  "version": "0.1.2",
  "description": "Ayuda a enviar el asset vendido y recopilar evidencia de Steam.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "alarms", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://steamcommunity.com/*", "https://api.steampowered.com/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "content_scripts": [
    {"matches": ["https://steamcommunity.com/tradeoffer/new/*"], "js": ["content.js"], "run_at": "document_idle"},
    {"matches": ["https://steamcommunity.com/tradeoffer/new/*"], "js": ["page.js"], "run_at": "document_idle", "world": "MAIN"}
  ],
  "externally_connectable": {"matches": []},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
